{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://real-time-collaborative-code-whiteboard-editor-production.up.railway.app/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://real-time-collaborative-code-whiteboard-editor-production.up.railway.app/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}